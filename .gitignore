__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
.pytest_cache/
.coverage
htmlcov/
coverage.xml
*.db
*.db-wal
*.db-shm

# PyCharm project files. Machine specific: the module file names an
# interpreter that means nothing on another machine, and workspace.xml is
# editor layout that changes every session. The run configurations are the
# exception. They name $PROJECT_DIR$ and the module's own interpreter rather
# than any path on this machine, so they are kept and shared.
.idea/*
!.idea/runConfigurations/

# VS Code. Same split: the launch configurations are shared, and everything
# else it puts here is per-user (interpreter choice, editor settings, the
# state of whatever extensions are installed).
.vscode/*
!.vscode/launch.json

# Agent tooling. A worktree is a checkout of this repository living inside
# it, which git records as a gitlink pointing at a commit no clone can
# resolve; one was committed here by accident and has been removed.
# settings.local.json is per-user. A shared .claude/settings.json is not
# ignored, so one can still be committed if ever wanted.
.claude/worktrees/
.claude/settings.local.json
